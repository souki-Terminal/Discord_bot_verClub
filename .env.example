# Discord Bot Token
# https://discord.com/developers/applications から取得したトークンを記載してください
DISCORD_TOKEN=your_discord_bot_token_here

# Botを管理するためのチャンネルID（このチャンネルに操作パネルが設置されます）
ADMIN_CHANNEL_ID=1546433070242992208

# 出欠パネルを送信するチャンネルID
ATTENDANCE_CHANNEL_ID=1546433930847064064

# 部室状況パネルを送信・更新するチャンネルID
ROOM_STATUS_CHANNEL_ID=1546433979299799110
